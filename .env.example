# Supabase — frontend (publikus, RLS vedett)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase — szerver oldali (seed script, API routes)
# SOHA ne VITE_ prefix — nem kerulhet a frontend bundle-be
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini — server side only
# SOHA ne VITE_ prefix
GEMINI_API_KEY=your-gemini-api-key

# Megosztas (Sharing V2) — server side only
# A public megosztasi token AES-256-GCM titkositasi kulcsa, hogy az owner ujra
# meg tudja jeleniteni az aktiv linket.
# Generalas: SHARE_TOKEN_ENCRYPTION_KEY="$(openssl rand -base64 32)"
# SOHA ne VITE_ prefix. Nelkule a link-letrehozas 500 SHARE_ENCRYPTION_FAILED-del hibazik.
SHARE_TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key

# Email meghivok (Sharing V2) — server side only
# Provider: Resend. SOHA ne VITE_ prefix.
RESEND_API_KEY=re_your-resend-api-key
INVITE_EMAIL_FROM="Az Utazasaim <noreply@example.com>"
APP_PUBLIC_URL=https://traveler.zsoltadel.go.ro

# Admin — server side only (hidden backup area, nem normal auth)
# SOHA ne VITE_ prefix
ADMIN_USER_ID=your-supabase-auth-user-uuid
ADMIN_PASSWORD=your-admin-challenge-password

# GitHub Backup — server side only
# SOHA ne VITE_ prefix
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_REPO=owner/repo
GITHUB_BACKUP_BRANCH=main
